<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CASA CAMPO | Premium Fly-In Lodge</title>
    <style>
        /* CSS Variables - Warm, Elegant Rural Palette */
        :root {
            --charcoal: #1a1b1e;
            --stone-gray: #3a3a3a;
            --warm-white: #f4efe8;
            --sunset-gold: #d4a373;
            --wood-brown: #8b5a2b;
            --dark-metal: #121212;
            --overlay: rgba(26, 27, 30, 0.85);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Helvetica Neue', Arial, sans-serif;
            background-color: var(--charcoal);
            color: var(--warm-white);
            overflow-x: hidden;
            line-height: 1.6;
        }

        h1, h2, h3, h4 {
            font-weight: 300;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        /* Navigation */
        nav {
            position: fixed;
            top: 0;
            width: 100%;
            padding: 20px 50px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 100;
            background: rgba(26, 27, 30, 0.7);
            backdrop-filter: blur(15px);
            border-bottom: 1px solid rgba(255,255,255,0.05);
            transition: all 0.3s ease;
        }

        .logo {
            font-size: 1.2rem;
            font-weight: 400;
            color: var(--warm-white);
            text-decoration: none;
            letter-spacing: 4px;
        }

        .nav-links a {
            color: var(--warm-white);
            text-decoration: none;
            margin-left: 30px;
            font-size: 0.85rem;
            transition: color 0.3s;
        }

        .nav-links a:hover {
            color: var(--sunset-gold);
        }

        /* Hero Section with Ember Particles */
        #hero {
            position: relative;
            height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            overflow: hidden;
            /* Using the stunning airstrip sunset image as the base */
            background: url('C2A0027E-2186-4BF0-880D-F22A9453E977.png') center/cover no-repeat;
            background-attachment: fixed;
        }

        #hero::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: linear-gradient(to bottom, rgba(0,0,0,0.3) 0%, rgba(26, 27, 30, 1) 100%);
            z-index: 1;
        }

        canvas#particle-canvas {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            z-index: 2;
            pointer-events: none;
        }

        .hero-content {
            position: relative;
            z-index: 3;
            padding: 0 20px;
        }

        .hero-content h1 {
            font-size: 4.5rem;
            margin-bottom: 20px;
            text-shadow: 0 10px 30px rgba(0,0,0,0.8);
            color: #fff;
        }

        .hero-content p {
            font-size: 1.2rem;
            max-width: 700px;
            margin: 0 auto 40px;
            color: #e0e0e0;
            text-shadow: 0 2px 10px rgba(0,0,0,0.8);
        }

        .cta-btn {
            display: inline-block;
            padding: 15px 40px;
            border: 1px solid var(--sunset-gold);
            color: var(--sunset-gold);
            text-decoration: none;
            text-transform: uppercase;
            letter-spacing: 2px;
            transition: all 0.4s ease;
            background: rgba(0,0,0,0.4);
            cursor: pointer;
            backdrop-filter: blur(5px);
        }

        .cta-btn:hover {
            background: var(--sunset-gold);
            color: var(--charcoal);
        }

        /* General Section Styling */
        section {
            padding: 100px 50px;
            position: relative;
            z-index: 10;
        }

        .section-header {
            text-align: center;
            margin-bottom: 60px;
        }

        .section-header h2 {
            font-size: 2.5rem;
            color: var(--sunset-gold);
            margin-bottom: 20px;
        }

        .section-header p {
            max-width: 800px;
            margin: 0 auto;
            font-size: 1.1rem;
            color: #bbb;
        }

        /* Concept Block */
        #concept {
            background: var(--charcoal);
        }

        .grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 50px;
            max-width: 1400px;
            margin: 0 auto;
            align-items: center;
        }

        .text-block h3 {
            color: var(--warm-white);
            font-size: 1.8rem;
            margin-bottom: 20px;
        }

        .text-block p {
            margin-bottom: 20px;
            color: #ccc;
        }

        .text-block ul {
            list-style: none;
            margin-top: 20px;
        }

        .text-block li {
            margin-bottom: 15px;
            padding-left: 25px;
            position: relative;
            color: #ddd;
        }

        .text-block li::before {
            content: '✈';
            position: absolute;
            left: 0;
            color: var(--sunset-gold);
            font-size: 0.9rem;
        }

        .image-block {
            height: 500px;
            border-radius: 5px;
            background-size: cover;
            background-position: center;
            box-shadow: 0 20px 50px rgba(0,0,0,0.5);
        }

        /* 3D Features Section */
        #features {
            background: var(--dark-metal);
        }

        .card-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 40px;
            perspective: 1000px;
            max-width: 1400px;
            margin: 0 auto;
        }

        .feature-card {
            position: relative;
            height: 450px;
            border-radius: 5px;
            transform-style: preserve-3d;
            transition: transform 0.1s;
            cursor: pointer;
            overflow: hidden;
            box-shadow: 0 15px 35px rgba(0,0,0,0.6);
        }

        .card-bg {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background-size: cover;
            background-position: center;
            transition: transform 0.5s ease;
        }

        .feature-card:hover .card-bg {
            transform: scale(1.05);
        }

        .card-1 .card-bg { background-image: url('C2A0027E-2186-4BF0-880D-F22A9453E977.png'); }
        .card-2 .card-bg { background-image: url('IMG_3178.jpg'); }
        .card-3 .card-bg { background-image: url('C5AD88BB-9576-4434-9CD8-7190F9245437.PNG'); }

        .card-overlay {
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: linear-gradient(to top, rgba(26, 27, 30, 0.95) 0%, rgba(26, 27, 30, 0.2) 100%);
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            padding: 30px;
            transform: translateZ(60px);
        }

        .card-overlay h3 {
            font-size: 1.5rem;
            margin-bottom: 15px;
            color: var(--sunset-gold);
        }

        .card-overlay p {
            font-size: 0.95rem;
            color: #ddd;
        }

        /* Architecture & Layout Section */
        #architecture {
            background: var(--charcoal);
            position: relative;
        }

        /* Full width banner */
        .wide-banner {
            width: 100%;
            height: 400px;
            background: url('IMG_3183.jpg') center/cover;
            background-attachment: fixed;
            margin: 60px 0;
            position: relative;
        }
        
        .wide-banner::after {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.4);
        }

        /* Storytelling / Arrival */
        .arrival-steps {
            display: flex;
            flex-direction: column;
            gap: 30px;
            margin-top: 40px;
        }

        .step {
            display: flex;
            align-items: flex-start;
            gap: 20px;
            background: rgba(255,255,255,0.03);
            padding: 20px;
            border-left: 2px solid var(--sunset-gold);
            transition: transform 0.3s;
        }

        .step:hover {
            transform: translateX(10px);
            background: rgba(255,255,255,0.05);
        }

        .step-num {
            font-size: 2rem;
            color: var(--sunset-gold);
            font-weight: bold;
            line-height: 1;
        }

        /* Footer */
        footer {
            background: #0d0d0d;
            padding: 60px 50px;
            text-align: center;
            border-top: 1px solid #222;
        }

        footer p {
            color: #666;
            font-size: 0.9rem;
            margin-top: 20px;
        }

        /* Scroll Reveal Animation Classes */
        .reveal {
            opacity: 0;
            transform: translateY(40px);
            transition: all 0.8s ease-out;
        }

        .reveal.active {
            opacity: 1;
            transform: translateY(0);
        }

        /* Responsive */
        @media (max-width: 900px) {
            .grid-2 { grid-template-columns: 1fr; }
            .hero-content h1 { font-size: 3rem; }
            nav { flex-direction: column; gap: 15px; padding: 15px; }
            .nav-links a { margin: 0 15px; }
        }
    </style>
</head>
<body>

    <nav>
        <a href="#" class="logo">HOTEL DE CAMPO</a>
        <div class="nav-links">
            <a href="#concept">The Concept</a>
            <a href="#features">Experience</a>
            <a href="#architecture">Architecture</a>
            <a href="#arrival">The Arrival</a>
        </div>
    </nav>

    <header id="hero">
        <canvas id="particle-canvas"></canvas>
        <div class="hero-content reveal active">
            <h1>The Ultimate Fly-In Lodge</h1>
            <p>A premium boutique hotel integrating aviation, luxury hospitality, and the untamed nature of Northern Entre Ríos.</p>
            <a href="#concept" class="cta-btn">Discover the Destination</a>
        </div>
    </header>

    <section id="concept">
        <div class="section-header reveal">
            <h2>Boutique Lodge & Private Aerodrome</h2>
            <p>We combine three high-value concepts rarely integrated in Argentina: boutique rural hospitality, premium experiences, and direct private flight access. This transforms the hotel into a destination in itself.</p>
        </div>
        
        <div class="grid-2 reveal">
            <div class="image-block" style="background-image: url('99550152-CAE6-4FBF-8753-A280FEF804D7.png');"></div>
            <div class="text-block">
                <h3>A Highly Differentiated Proposition</h3>
                <p>Designed for an exclusive segment, including international tourists, executives, premium sports fishermen, and private aircraft owners. The experience begins the moment you land.</p>
                <ul>
                    <li>13.2 Hectares of private grounds with natural landscaping</li>
                    <li>Exclusive capacity of 22 guests (8 Double, 2 Triple Rooms)</li>
                    <li>Total privacy, personalized service, and a relaxed atmosphere</li>
                    <li>Hangar, VIP reception, and pilot lounge on site</li>
                </ul>
            </div>
        </div>
    </section>

    <section id="features">
        <div class="section-header reveal">
            <h2>Experiential Luxury</h2>
            <p>Every aspect of the lodge is crafted to generate an emotional connection with the rural landscape and Argentine traditions.</p>
        </div>

        <div class="card-grid reveal">
            <div class="feature-card card-1">
                <div class="card-bg"></div>
                <div class="card-overlay">
                    <h3>Private Aviation</h3>
                    <p>An 800 x 20m private airstrip designed for light aviation and turboprops (Cessna, Piper, Caravan). Placed at a perfect distance to ensure safety and silence for guests.</p>
                </div>
            </div>

            <div class="feature-card card-2">
                <div class="card-bg"></div>
                <div class="card-overlay">
                    <h3>Boutique Suites</h3>
                    <p>Designed with an efficient central corridor and private exterior galleries. Acoustic separation and panoramic views position the hotel as an exclusive, low-density retreat.</p>
                </div>
            </div>

            <div class="feature-card card-3">
                <div class="card-bg"></div>
                <div class="card-overlay">
                    <h3>Regional Gastronomy</h3>
                    <p>A spectacular glass-enclosed dining room with an open kitchen. Enjoy premium meats, open fires, and regional cuisine with permanent visual connection to the countryside.</p>
                </div>
            </div>
        </div>
    </section>

    <div class="wide-banner"></div>

    <section id="architecture">
        <div class="grid-2 reveal">
            <div class="text-block">
                <h3>Immersive Architecture</h3>
                <p>The single-story layout perfectly integrates into the environment, avoiding aggressive visual impact while maximizing accessibility and operational efficiency. The chosen aesthetic blends stone, wood, black metal, and large glass panes.</p>
                <p><strong>The Central Fire Pit (Fogón):</strong> The nocturnal heart of the hotel. It provides an authentic Argentine identity—ideal for folklore, wine tastings, and stargazing under the vast rural sky.</p>
                <p><strong>Multi-Purpose Room (SUM):</strong> A flexible space designed for yoga, wellness, corporate events, workshops, and exclusive private gatherings.</p>
            </div>
            <div class="image-block" style="background-image: url('IMG_3184.jpg'); background-size: contain; background-repeat: no-repeat; background-color: #eee;"></div>
        </div>
    </section>

    <section id="arrival" style="background: var(--dark-metal);">
        <div class="section-header reveal">
            <h2>The Arrival Experience</h2>
            <p>The aerial entrance completely transforms the guest's perception, making the journey a fundamental part of the adventure.</p>
        </div>

        <div class="grid-2 reveal" style="align-items: start;">
            <div class="arrival-steps">
                <div class="step">
                    <div class="step-num">01</div>
                    <div>
                        <h4>Takeoff</h4>
                        <p>Depart from Buenos Aires, Rosario, Córdoba, Montevideo, or Asunción in a private aircraft.</p>
                    </div>
                </div>
                <div class="step">
                    <div class="step-num">02</div>
                    <div>
                        <h4>Scenic Flight</h4>
                        <p>Enjoy a panoramic journey over the fields, estuaries, the Paraná River, and the native forests of Entre Ríos.</p>
                    </div>
                </div>
                <div class="step">
                    <div class="step-num">03</div>
                    <div>
                        <h4>Direct Landing</h4>
                        <p>Touch down directly inside the establishment on our secure 800m private runway.</p>
                    </div>
                </div>
                <div class="step">
                    <div class="step-num">04</div>
                    <div>
                        <h4>Premium Reception</h4>
                        <p>Be greeted by a safari-style vehicle, champagne welcome, and a personalized check-in by the central fire pit.</p>
                    </div>
                </div>
            </div>
            <div class="image-block" style="background-image: url('C2A0027E-2186-4BF0-880D-F22A9453E977.png'); height: 100%;"></div>
        </div>
    </section>

    <footer>
        <h2 style="color: var(--sunset-gold); font-size: 1.5rem; letter-spacing: 3px;">HOTEL DE CAMPO PREMIUM</h2>
        <p>Federal, Entre Ríos, Argentina</p>
        <p>&copy; 2026 Fly-In Lodge & Boutique Hotel. All rights reserved.</p>
    </footer>

    <script>
        // --- 1. Immersive 3D Ember/Dust Particle System for Hero ---
        const canvas = document.getElementById('particle-canvas');
        const ctx = canvas.getContext('2d');
        let width, height;
        let particles = [];

        // Mouse interaction for parallax
        let mouseX = 0;
        let mouseY = 0;

        function initParticles() {
            width = canvas.width = window.innerWidth;
            height = canvas.height = window.innerHeight;
            particles = [];
            // Create particles
            for (let i = 0; i < 150; i++) {
                particles.push({
                    x: Math.random() * width,
                    y: Math.random() * height,
                    z: Math.random() * 2 + 0.1, // Depth for 3D parallax
                    radius: Math.random() * 2 + 0.5,
                    vx: (Math.random() - 0.5) * 0.5,
                    vy: (Math.random() - 1) * 0.5, // Float upwards
                    alpha: Math.random() * 0.8 + 0.2,
                    color: Math.random() > 0.5 ? '#d4a373' : '#ff7a00' // Gold and orange embers
                });
            }
        }

        window.addEventListener('resize', initParticles);

        // Track mouse on hero section
        document.getElementById('hero').addEventListener('mousemove', (e) => {
            mouseX = (e.clientX - width / 2) * 0.05;
            mouseY = (e.clientY - height / 2) * 0.05;
        });

        function animateParticles() {
            ctx.clearRect(0, 0, width, height);

            particles.forEach(p => {
                // Move particle
                p.x += p.vx;
                p.y += p.vy;

                // Apply Parallax offset based on depth (z)
                let px = p.x - (mouseX * p.z);
                let py = p.y - (mouseY * p.z);

                // Wrap around edges
                if (p.x < 0) p.x = width;
                if (p.x > width) p.x = 0;
                if (p.y < 0) p.y = height;
                if (p.y > height) p.y = 0;

                // Draw ember
                ctx.beginPath();
                ctx.arc(px, py, p.radius * p.z, 0, Math.PI * 2);
                ctx.fillStyle = p.color;
                // Fade based on z-index and native alpha
                ctx.globalAlpha = p.alpha * (p.z / 2);
                ctx.shadowBlur = 10;
                ctx.shadowColor = p.color;
                ctx.fill();
            });

            requestAnimationFrame(animateParticles);
        }

        initParticles();
        animateParticles();

        // --- 2. 3D Tilt Effect for Feature Cards ---
        const cards = document.querySelectorAll('.feature-card');

        cards.forEach(card => {
            card.addEventListener('mousemove', function(e) {
                const rect = this.getBoundingClientRect();
                const centerX = rect.left + rect.width / 2;
                const centerY = rect.top + rect.height / 2;
                const mX = e.clientX - centerX;
                const mY = e.clientY - centerY;

                // Max rotation of 15 degrees
                const rotateX = (mY / (rect.height / 2)) * -15; 
                const rotateY = (mX / (rect.width / 2)) * 15;

                this.style.transform = `rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
            });

            card.addEventListener('mouseleave', function() {
                this.style.transform = 'rotateX(0deg) rotateY(0deg)';
                this.style.transition = 'transform 0.5s cubic-bezier(0.23, 1, 0.32, 1)';
                
                setTimeout(() => {
                    this.style.transition = 'transform 0.1s';
                }, 500);
            });
        });

        // --- 3. Scroll Reveal Animations ---
        const revealElements = document.querySelectorAll('.reveal');

        const revealObserver = new IntersectionObserver((entries, observer) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('active');
                    observer.unobserve(entry.target); // Only animate once
                }
            });
        }, {
            root: null,
            threshold: 0.15, // Trigger when 15% visible
            rootMargin: "0px 0px -50px 0px"
        });

        revealElements.forEach(el => revealObserver.observe(el));

        // --- 4. Smooth Scrolling for Navigation ---
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                document.querySelector(this.getAttribute('href')).scrollIntoView({
                    behavior: 'smooth'
                });
            });
        });
    </script>
</body>
</html>
